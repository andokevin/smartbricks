DATABASE_URL=postgresql+asyncpg://smartbricks:smartbricks@localhost:5435/smartbricks
JWT_SECRET=dev-secret-smartbricks-a-changer-en-production
ENVIRONMENT=development

# Copilote : mock | claude | gemini (mock = démo sans clé ni réseau)
LLM_PROVIDER=mock
# Budget total en dollars ; au-delà, l'application repasse automatiquement en mock.
LLM_BUDGET_USD=4

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=8000
CLAUDE_EFFORT=low
# Prix en dollars par million de tokens (obligatoires pour activer Claude).
CLAUDE_PRICE_INPUT_PER_MTOK=
CLAUDE_PRICE_OUTPUT_PER_MTOK=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8000
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
